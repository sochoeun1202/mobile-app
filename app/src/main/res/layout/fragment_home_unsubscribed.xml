<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="24dp">

    <!-- Top Bar Layout Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Circular Avatar with thin green border -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/primary_green"
            app:strokeWidth="1.5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/boy"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Logo text PROFIT -->
        <TextView
            android:id="@+id/tv_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/kantumruy_pro"
            android:text="PROFIT"
            android:textColor="@color/primary_green"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/card_avatar"
            app:layout_constraintTop_toTopOf="@id/card_avatar"
            app:layout_constraintBottom_toBottomOf="@id/card_avatar" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Top Divider -->
    <View
        android:id="@+id/divider_top"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/divider_color"
        app:layout_constraintTop_toBottomOf="@id/layout_top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Athlete Overview Area -->
    <TextView
        android:id="@+id/tv_label_overview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/kantumruy_pro"
        android:text="ATHLETE OVERVIEW"
        android:textColor="@color/primary_green"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        app:layout_constraintTop_toBottomOf="@id/divider_top"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Athlete Name and Status Badge Container -->
    <LinearLayout
        android:id="@+id/layout_athlete_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/tv_label_overview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_athlete_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/kantumruy_pro"
            android:text="Alex Rivera"
            android:textColor="@color/neutral_white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- ELITE Status Badge -->
        <LinearLayout
            android:id="@+id/badge_elite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/badge_elite_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_shield_check"
                app:tint="@color/neutral_white"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/kantumruy_pro"
                android:text="ELITE"
                android:textColor="@color/neutral_white"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Your Plan Section Header -->
    <TextView
        android:id="@+id/tv_label_plan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/kantumruy_pro"
        android:text="Your Plan"
        android:textColor="@color/label_grey"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/layout_athlete_name"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Plan Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_unlock_plan"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/card_dark"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/tv_label_plan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Green left accent strip -->
            <View
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="@color/primary_green" />

            <!-- Card center clickable label text -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/kantumruy_pro"
                android:text="Unlock Plan Now"
                android:textColor="@color/primary_green"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="false"
                android:focusable="false" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
