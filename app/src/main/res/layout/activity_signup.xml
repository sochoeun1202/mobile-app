<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".SignupActivity">

    <!-- ScrollView for responsiveness when keyboard is visible -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Card container for signup form -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/signup_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="32dp"
                android:background="@drawable/card_background"
                android:padding="32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Header Subtitle -->
                <TextView
                    android:id="@+id/signup_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JOIN THE ELITE"
                    android:textColor="@color/primary_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Header Title -->
                <TextView
                    android:id="@+id/signup_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-black"
                    android:text="CREATE ACCOUNT"
                    android:textColor="@color/neutral_white"
                    android:textSize="28sp"
                    android:textStyle="bold|italic"
                    android:letterSpacing="0.02"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/signup_subtitle" />

                <!-- Title Underline -->
                <View
                    android:id="@+id/title_underline"
                    android:layout_width="0dp"
                    android:layout_height="2.5dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/neutral_white"
                    app:layout_constraintStart_toStartOf="@id/signup_title"
                    app:layout_constraintEnd_toEndOf="@id/signup_title"
                    app:layout_constraintTop_toBottomOf="@id/signup_title" />

                <!-- Username Label -->
                <TextView
                    android:id="@+id/username_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:text="USERNAME"
                    android:textColor="@color/label_grey"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/title_underline" />

                <!-- Username Input Box -->
                <LinearLayout
                    android:id="@+id/username_input_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/username_label">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/label_grey"
                        tools:ignore="ContentDescription" />

                    <EditText
                        android:id="@+id/et_username"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Enter your username"
                        android:textColorHint="@color/hint_grey"
                        android:textColor="@color/neutral_white"
                        android:textSize="15sp"
                        android:inputType="text"
                        android:paddingVertical="8dp"
                        android:importantForAutofill="no" />
                </LinearLayout>

                <!-- Username Divider Line -->
                <View
                    android:id="@+id/username_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/divider_color"
                    app:layout_constraintTop_toBottomOf="@id/username_input_row" />

                <!-- Phone Number Label -->
                <TextView
                    android:id="@+id/phone_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="PHONE NUMBER"
                    android:textColor="@color/label_grey"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/username_divider" />

                <!-- Phone Number Input Box -->
                <LinearLayout
                    android:id="@+id/phone_input_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/phone_label">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/label_grey"
                        tools:ignore="ContentDescription" />

                    <EditText
                        android:id="@+id/et_phone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="+885 000-0000"
                        android:textColorHint="@color/hint_grey"
                        android:textColor="@color/neutral_white"
                        android:textSize="15sp"
                        android:inputType="phone"
                        android:paddingVertical="8dp"
                        android:importantForAutofill="no" />
                </LinearLayout>

                <!-- Phone Divider Line -->
                <View
                    android:id="@+id/phone_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/divider_color"
                    app:layout_constraintTop_toBottomOf="@id/phone_input_row" />

                <!-- Password Label -->
                <TextView
                    android:id="@+id/password_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="PASSWORD"
                    android:textColor="@color/label_grey"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/phone_divider" />

                <!-- Password Input Box -->
                <LinearLayout
                    android:id="@+id/password_input_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/password_label">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/label_grey"
                        tools:ignore="ContentDescription" />

                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Enter your password"
                        android:textColorHint="@color/hint_grey"
                        android:textColor="@color/neutral_white"
                        android:textSize="15sp"
                        android:inputType="textPassword"
                        android:paddingVertical="8dp"
                        android:importantForAutofill="no" />

                    <ImageView
                        android:id="@+id/btn_toggle_password"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_visibility"
                        android:contentDescription="Toggle Password Visibility"
                        app:tint="@color/label_grey"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <!-- Password Divider Line -->
                <View
                    android:id="@+id/password_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/divider_color"
                    app:layout_constraintTop_toBottomOf="@id/password_input_row" />

                <!-- Confirm Password Label -->
                <TextView
                    android:id="@+id/confirm_password_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="CONFIRM PASSWORD"
                    android:textColor="@color/label_grey"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/password_divider" />

                <!-- Confirm Password Input Box -->
                <LinearLayout
                    android:id="@+id/confirm_password_input_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/confirm_password_label">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_shield_check"
                        app:tint="@color/label_grey"
                        tools:ignore="ContentDescription" />

                    <EditText
                        android:id="@+id/et_confirm_password"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Re-enter your password"
                        android:textColorHint="@color/hint_grey"
                        android:textColor="@color/neutral_white"
                        android:textSize="15sp"
                        android:inputType="textPassword"
                        android:paddingVertical="8dp"
                        android:importantForAutofill="no" />

                    <ImageView
                        android:id="@+id/btn_toggle_confirm_password"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_visibility"
                        android:contentDescription="Toggle Confirm Password Visibility"
                        app:tint="@color/label_grey"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <!-- Confirm Password Divider Line -->
                <View
                    android:id="@+id/confirm_password_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/divider_color"
                    app:layout_constraintTop_toBottomOf="@id/confirm_password_input_row" />

                <!-- Terms and Privacy Checkbox Row -->
                <LinearLayout
                    android:id="@+id/terms_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/confirm_password_divider">

                    <CheckBox
                        android:id="@+id/cb_terms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/primary_green"
                        android:minHeight="0dp"
                        android:minWidth="0dp" />

                    <TextView
                        android:id="@+id/tv_terms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Agree to our Term of Privacy Policy"
                        android:textColor="@color/label_grey"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Start Training Button -->
                <LinearLayout
                    android:id="@+id/btn_signup"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/button_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24dp"
                    app:layout_constraintTop_toBottomOf="@id/terms_container"
                    tools:ignore="UseEasyTouchTarget">

                    <TextView
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:text="START TRAINING"
                         android:textColor="@color/background_dark"
                         android:textSize="15sp"
                         android:textStyle="bold"
                         android:letterSpacing="0.05" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_lightning"
                        app:tint="@color/background_dark"
                        tools:ignore="ContentDescription" />

                </LinearLayout>

                <!-- FooterSIGN IN navigation link -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_signup"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Already a member? "
                        android:textColor="@color/label_grey"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_sign_in_link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SIGN IN"
                        android:textColor="@color/primary_green"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
