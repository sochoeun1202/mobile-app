<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Top Bar Layout Container -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_top_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Circular Avatar with thin green border -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeColor="@color/primary_green"
                    app:strokeWidth="1.5dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageView
                        android:id="@+id/iv_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/boy"
                        android:scaleType="centerCrop"
                        tools:ignore="ContentDescription" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Logo text PROFIT -->
                <TextView
                    android:id="@+id/tv_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/kantumruy_pro"
                    android:text="PROFIT"
                    android:textColor="@color/primary_green"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/card_avatar"
                    app:layout_constraintTop_toTopOf="@id/card_avatar"
                    app:layout_constraintBottom_toBottomOf="@id/card_avatar" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Top Divider -->
            <View
                android:id="@+id/divider_top"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/divider_color"
                app:layout_constraintTop_toBottomOf="@id/layout_top_bar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Membership Section Header -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/divider_top"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tv_label_membership"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kantumruy_pro"
                    android:text="MEMBERSHIP"
                    android:textColor="@color/primary_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tv_label_select_tier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kantumruy_pro"
                    android:text="SELECT YOUR TIER"
                    android:textColor="@color/label_grey"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Elite Performance Hero Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_dark"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/layout_section_header"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- Left stripe -->
                    <View
                        android:id="@+id/hero_stripe"
                        android:layout_width="4dp"
                        android:layout_height="0dp"
                        android:background="@color/primary_green"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tv_hero_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:fontFamily="@font/kantumruy_pro"
                        android:text="Elite Performance"
                        android:textColor="@color/neutral_white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/hero_stripe"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_hero_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/kantumruy_pro"
                        android:text="Unlock your maximum metabolic potential with professional-grade tools."
                        android:textColor="@color/hint_grey"
                        android:textSize="12sp"
                        app:layout_constraintStart_toEndOf="@id/hero_stripe"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_hero_title" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Tiers List Container -->
            <LinearLayout
                android:id="@+id/layout_tiers_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/card_hero"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Bronze Tier Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_bronze"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_dark"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/divider_color">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <!-- Left square text indicator -->
                        <FrameLayout
                            android:id="@+id/iv_bronze_box"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/tab_selected_background"
                            android:backgroundTint="@color/tertiary_dark"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/kantumruy_pro"
                                android:text="1D"
                                android:textColor="@color/neutral_white"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                        </FrameLayout>

                        <!-- Title and Badge -->
                        <LinearLayout
                            android:id="@+id/layout_bronze_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            app:layout_constraintStart_toEndOf="@id/iv_bronze_box"
                            app:layout_constraintEnd_toStartOf="@id/layout_bronze_price"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/kantumruy_pro"
                                android:text="Bronze"
                                android:textColor="@color/neutral_white"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/badge_elite_bg"
                                android:backgroundTint="@color/tertiary_dark"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="ENTRY"
                                android:textColor="@color/neutral_white"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                tools:ignore="UnusedAttribute" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/kantumruy_pro"
                            android:text="1 Day Pass"
                            android:textColor="@color/hint_grey"
                            android:textSize="12sp"
                            app:layout_constraintStart_toEndOf="@id/iv_bronze_box"
                            app:layout_constraintEnd_toStartOf="@id/layout_bronze_price"
                            app:layout_constraintTop_toBottomOf="@id/layout_bronze_title"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <!-- Price Section -->
                        <LinearLayout
                            android:id="@+id/layout_bronze_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/kantumruy_pro"
                                android:text="$9.99"
                                android:textColor="@color/neutral_white"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/kantumruy_pro"
                                android:text="ONE-TIME"
                                android:textColor="@color/hint_grey"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Elite Tier Card (Selected/Bordered by default as mockup) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_elite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_dark"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/primary_green">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <!-- Popular Badge on top right -->
                        <TextView
                            android:id="@+id/badge_popular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/badge_elite_bg"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="POPULAR"
                            android:textColor="@color/background_dark"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:ignore="UnusedAttribute" />

                        <!-- Left square lightning indicator -->
                        <FrameLayout
                            android:id="@+id/iv_elite_box"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/tab_selected_background"
                            android:backgroundTint="@color/primary_green"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_lightning"
                                app:tint="@color/neutral_white"
                                tools:ignore="ContentDescription" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_elite_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:fontFamily="@font/kantumruy_pro"
                            android:text="Elite"
                            android:textColor="@color/neutral_white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toEndOf="@id/iv_elite_box"
                            app:layout_constraintEnd_toStartOf="@id/layout_elite_price"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/kantumruy_pro"
                            android:text="1 Week Trial"
                            android:textColor="@color/hint_grey"
                            android:textSize="12sp"
                            app:layout_constraintStart_toEndOf="@id/iv_elite_box"
                            app:layout_constraintEnd_toStartOf="@id/layout_elite_price"
                            app:layout_constraintTop_toBottomOf="@id/tv_elite_title"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <!-- Price Section -->
                        <LinearLayout
                            android:id="@+id/layout_elite_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/kantumruy_pro"
                                android:text="$24.99"
                                android:textColor="@color/primary_green"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/kantumruy_pro"
                                android:text="LIMITED"
                                android:textColor="@color/hint_grey"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Master Tier Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_master"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_dark"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/divider_color">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <!-- Left square ribbon indicator -->
                        <FrameLayout
                            android:id="@+id/iv_master_box"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/tab_selected_background"
                            android:backgroundTint="@color/tertiary_dark"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_shield_check"
                                app:tint="@color/neutral_white"
                                tools:ignore="ContentDescription" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_master_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:fontFamily="@font/kantumruy_pro"
                            android:text="Master"
                            android:textColor="@color/neutral_white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toEndOf="@id/iv_master_box"
                            app:layout_constraintEnd_toStartOf="@id/layout_master_price"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/kantumruy_pro"
                            android:text="1 Month Subscription"
                            android:textColor="@color/hint_grey"
                            android:textSize="12sp"
                            app:layout_constraintStart_toEndOf="@id/iv_master_box"
                            app:layout_constraintEnd_toStartOf="@id/layout_master_price"
                            app:layout_constraintTop_toBottomOf="@id/tv_master_title"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <!-- Price Section -->
                        <LinearLayout
                            android:id="@+id/layout_master_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/kantumruy_pro"
                                android:text="$59.99"
                                android:textColor="@color/neutral_white"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/kantumruy_pro"
                                android:text="MONTHLY"
                                android:textColor="@color/hint_grey"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- VIP Tier Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_vip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_dark"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/divider_color">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <!-- Left square star indicator -->
                        <FrameLayout
                            android:id="@+id/iv_vip_box"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/tab_selected_background"
                            android:backgroundTint="@color/tertiary_dark"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_star"
                                app:tint="@color/neutral_white"
                                tools:ignore="ContentDescription" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_vip_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:fontFamily="@font/kantumruy_pro"
                            android:text="VIP"
                            android:textColor="@color/neutral_white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toEndOf="@id/iv_vip_box"
                            app:layout_constraintEnd_toStartOf="@id/layout_vip_price"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/kantumruy_pro"
                            android:text="1 Year Full Access"
                            android:textColor="@color/hint_grey"
                            android:textSize="12sp"
                            app:layout_constraintStart_toEndOf="@id/iv_vip_box"
                            app:layout_constraintEnd_toStartOf="@id/layout_vip_price"
                            app:layout_constraintTop_toBottomOf="@id/tv_vip_title"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <!-- Price Section -->
                        <LinearLayout
                            android:id="@+id/layout_vip_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/kantumruy_pro"
                                android:text="$499.99"
                                android:textColor="@color/neutral_white"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/kantumruy_pro"
                                android:text="SAVE 30%"
                                android:textColor="@color/hint_grey"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
