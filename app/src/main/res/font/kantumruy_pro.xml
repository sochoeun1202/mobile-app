<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Regular -->
    <font
        app:fontStyle="normal"
        app:fontWeight="400"
        app:font="@font/kantumruy_pro_regular" />

    <!-- Italic -->
    <font
        app:fontStyle="italic"
        app:fontWeight="400"
        app:font="@font/kantumruy_pro_italic" />

    <!-- Light -->
    <font
        app:fontStyle="normal"
        app:fontWeight="300"
        app:font="@font/kantumruy_pro_light" />

    <!-- Extra Light -->
    <font
        app:fontStyle="normal"
        app:fontWeight="200"
        app:font="@font/kantumruy_pro_extralight" />

    <!-- Semibold -->
    <font
        app:fontStyle="normal"
        app:fontWeight="600"
        app:font="@font/kantumruy_pro_semibold" />

    <!-- Bold -->
    <font
        app:fontStyle="normal"
        app:fontWeight="700"
        app:font="@font/kantumruy_pro_bold" />
</font-family>
