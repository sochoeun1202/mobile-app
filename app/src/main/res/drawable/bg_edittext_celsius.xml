<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow layer -->
    <item android:top="2dp" android:left="2dp">
        <shape>
            <solid android:color="#20000000"/> <!-- soft shadow -->
            <corners android:radius="4dp"/>
        </shape>
    </item>

    <!-- Main background -->
    <item>
        <shape>
            <solid android:color="#FFFFFF"/>
            <corners android:radius="4dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/primary"/>
            <padding
                android:left="14dp"
                android:top="14dp"
                android:right="14dp"
                android:bottom="14dp"/>
        </shape>
    </item>

</layer-list>